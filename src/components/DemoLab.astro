---
// The live demo on the landing page: the whole app (sidebar like Paperclip's, every section working) with fake data,
// no backend and no network. Logic: src/lib/demo.ts. Styles: the "demo" block in /assets/site.css.
// Copy follows .claude/skills/apipeline-saudi-voice; every Arabic string has its English pair in i18n-en-site.js.
const IDEAS = [
  ['skin', 'إطلاق منتج جديد لعناية البشرة'],
  ['home', 'عرض نهاية الموسم لمتجر أدوات منزلية'],
  ['clinic', 'حجز جلسات رعاية صحية في المنزل'],
];
---
<section class="st-sec dm" id="demo" aria-labelledby="demoH">
  <div class="st-wrap">
    <header class="st-head" data-reveal>
      <span class="kick">جرّبه بنفسك</span>
      <h2 id="demoH">عرض تجريبي مباشر، دون تسجيل</h2>
      <p>النظام كاملًا كما يراه عملاؤنا: كل الأقسام تعمل ببيانات افتراضية داخل متصفحك فقط، دون تسجيل.</p>
      <p class="dm-badge"><span class="st-chip">عرض ببيانات افتراضية</span></p>
    </header>

    <div class="dm-shell dm-app">
      <aside class="dm-side">
        <div class="dm-org"><span class="dm-org-logo" aria-hidden="true">ر</span><div><b>متجر روتين</b><small>مساحة تجريبية</small></div></div>
      <div class="dm-tabs" role="tablist" aria-orientation="vertical" aria-label="أقسام النظام">
        <span class="dm-grp" role="presentation">الحملات</span>
        <button type="button" role="tab" id="dmt-dream" aria-controls="dmp-dream" aria-selected="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4z M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg><span class="dm-tl">احلم</span></button>
        <button type="button" role="tab" id="dmt-analytics" aria-controls="dmp-analytics" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10 M10 20V4 M16 20v-7 M22 20H2"/></svg><span class="dm-tl">التحليلات</span></button>
        <button type="button" role="tab" id="dmt-buyer" aria-controls="dmp-buyer" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg><span class="dm-tl">مدير الإعلانات</span><b class="dm-count" data-count-for="buyer" data-n="3">٣</b></button>
        <span class="dm-grp" role="presentation">المحتوى</span>
        <button type="button" role="tab" id="dmt-social" aria-controls="dmp-social" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg><span class="dm-tl">التواصل الاجتماعي</span><b class="dm-count" data-count-for="social" data-n="2">٢</b></button>
        <button type="button" role="tab" id="dmt-listen" aria-controls="dmp-listen" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z M20 20l-4-4"/></svg><span class="dm-tl">الرصد</span><b class="dm-count" data-count-for="listen" data-n="5">٥</b></button>
        <button type="button" role="tab" id="dmt-design" aria-controls="dmp-design" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4z M4 16l5-5 4 4 3-3 4 4 M15 8.5a1.5 1.5 0 1 0 0 .01"/></svg><span class="dm-tl">التصميم</span></button>
        <button type="button" role="tab" id="dmt-voice" aria-controls="dmp-voice" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z M5 11a7 7 0 0 0 14 0 M12 18v3"/></svg><span class="dm-tl">الصوت</span></button>
        <span class="dm-grp" role="presentation">النظام</span>
        <button type="button" role="tab" id="dmt-knowledge" aria-controls="dmp-knowledge" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z M5 17a3 3 0 0 1 3-3h11"/></svg><span class="dm-tl">المعرفة</span></button>
        <button type="button" role="tab" id="dmt-connect" aria-controls="dmp-connect" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 15l6-6 M10 6l1-1a5 5 0 0 1 7 7l-1 1 M14 18l-1 1a5 5 0 0 1-7-7l1-1"/></svg><span class="dm-tl">الربط والإعدادات</span></button>
      </div>
        <p class="dm-side-foot"><span class="dm-live" aria-hidden="true"></span><span>آخر مزامنة قبل دقيقتين</span></p>
      </aside>
      <div class="dm-main">
        <div class="dm-top">
          <b class="dm-crumb" id="dmCrumb">احلم</b>
          <label class="dm-search"><span class="sr-only">بحث</span><input type="search" placeholder="ابحث في الحملات والمواد" id="dmSearch" autocomplete="off"></label>
          <span class="dm-bell" title="بانتظار موافقتك"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z M10 21h4"/></svg><b id="dmPending">٥</b><span class="sr-only">بانتظار موافقتك</span></span>
        </div>

      <!-- احلم -->
      <div class="dm-panel" role="tabpanel" id="dmp-dream" aria-labelledby="dmt-dream">
        <form class="dm-ask" id="dmAsk">
          <label for="dmIdea">ما فكرة حملتك؟</label>
          <div class="dm-ask-row">
            <input id="dmIdea" type="text" maxlength="120" autocomplete="off" placeholder="مثال: إطلاق منتج جديد لعناية البشرة">
            <button class="btn primary" type="submit">ابدأ</button>
          </div>
          <div class="dm-ideas" role="group" aria-label="أفكار جاهزة">
            {IDEAS.map(([k, t]) => <button type="button" class="dm-pill" data-idea={k}>{t}</button>)}
          </div>
        </form>
        <div class="dm-chat" id="dmChat" aria-live="polite"></div>
        <div class="dm-draft" id="dmDraft" hidden></div>
        <div class="dm-publish" id="dmPublishBar" hidden>
          <p><b id="dmApproved">٠</b> <span>من</span> <b id="dmTotal">٦</b> <span>أجزاء معتمدة</span></p>
          <button class="btn primary" type="button" id="dmPublish" disabled>انشر</button>
        </div>
        <dialog class="dm-dialog" id="dmConfirm" aria-labelledby="dmConfirmH">
          <h3 id="dmConfirmH">هذا ما سيُنشر في المنصات</h3>
          <p class="muted">تُنشر الحملات في المنصات <b>مباشرة</b> بعد تأكيدك.</p>
          <ul id="dmConfirmList"></ul>
          <p class="dm-note">عرض تجريبي: لا يُنفَّذ شيء فعليًا.</p>
          <div class="st-acts"><button class="btn primary" type="button" id="dmConfirmOk">تأكيد النشر</button><button class="btn ghost" type="button" id="dmConfirmNo">رجوع</button></div>
        </dialog>
      </div>

      <!-- التحليلات -->
      <div class="dm-panel" role="tabpanel" id="dmp-analytics" aria-labelledby="dmt-analytics" hidden>
        <div class="dm-row">
          <h3>ملخص الأداء</h3>
          <div class="seg" role="group" aria-label="الفترة" id="dmRange">
            <button type="button" data-days="7" aria-pressed="false">٧ أيام</button>
            <button type="button" data-days="30" aria-pressed="true">٣٠ يوم</button>
            <button type="button" data-days="90" aria-pressed="false">٩٠ يوم</button>
          </div>
        </div>
        <div class="dm-kpis" id="dmKpis"></div>
        <div class="dm-two">
          <figure class="dm-card dm-wide">
            <figcaption>رحلة العميل <small>مرّر المؤشر على أي مرحلة أو نسبة</small></figcaption>
            <div class="dm-fwrap"><svg id="dmFunnel" class="dm-funnel" viewBox="0 0 960 250" role="group" aria-label="رحلة العميل: الظهور، النقرات، أضاف للسلة، اشترى"></svg></div>
            <p id="dmFDetail" class="dm-fdetail" aria-live="polite"></p>
          </figure>
          <figure class="dm-card">
            <figcaption>الإنفاق والمبيعات يوميًا</figcaption>
            <svg id="dmChart" class="dm-chart" viewBox="0 0 320 140" role="img" aria-label="رسم الإنفاق والمبيعات يوميًا"></svg>
            <p class="dm-legend"><span class="sw a"></span><span>المبيعات</span> <span class="sw b"></span><span>الإنفاق</span></p>
          </figure>
          <figure class="dm-card">
            <figcaption>الأداء حسب المنصة</figcaption>
            <div class="dm-plat" id="dmPlat"></div>
          </figure>
          <figure class="dm-card dm-wide dm-cr">
            <div class="dm-cr-head">
              <figcaption>تحليل المواد الإعلانية <small>أي تصميم يحقق نتيجة، وأيها ملّه الجمهور</small></figcaption>
              <div class="seg" role="group" aria-label="ترتيب المواد" id="dmCrSort">
                <button type="button" data-sort="roas" aria-pressed="true">العائد</button>
                <button type="button" data-sort="cpa" aria-pressed="false">تكلفة الطلب</button>
                <button type="button" data-sort="ctr" aria-pressed="false">نسبة النقر</button>
              </div>
            </div>
            <div class="dm-cr-insight" id="dmCrInsight"></div>
            <div class="dm-cr-list" id="dmCr"></div>
          </figure>
        </div>
      </div>

      <!-- مدير الإعلانات -->
      <div class="dm-panel" role="tabpanel" id="dmp-buyer" aria-labelledby="dmt-buyer" hidden>
        <div class="dm-recs" id="dmRecs"></div>
        <div class="dm-card dm-log">
          <h3>سجل القرارات</h3>
          <ol id="dmLog"><li class="muted">لا توجد قرارات حتى الآن.</li></ol>
        </div>
      </div>

      <!-- التواصل الاجتماعي -->
      <div class="dm-panel" role="tabpanel" id="dmp-social" aria-labelledby="dmt-social" hidden>
        <form class="dm-card dm-compose" id="dmCompose">
          <label for="dmPost">منشور جديد</label>
          <textarea id="dmPost" rows="3" maxlength="400">روتينك الصباحي في دقيقتين. منتجنا الجديد متوفر الآن بتوصيل سريع.</textarea>
          <div class="dm-compose-bar">
            <div class="dm-chips" role="group" aria-label="المنصات" id="dmPostPlats">
              <button type="button" class="dm-pill" aria-pressed="true" data-plat="Instagram">Instagram</button>
              <button type="button" class="dm-pill" aria-pressed="true" data-plat="TikTok">TikTok</button>
              <button type="button" class="dm-pill" aria-pressed="false" data-plat="X">X</button>
              <button type="button" class="dm-pill" aria-pressed="false" data-plat="Snapchat">Snapchat</button>
            </div>
            <label class="dm-when"><span>الموعد</span><select id="dmPostDay"></select></label>
            <button class="btn primary" type="submit">أرسل للموافقة</button>
          </div>
        </form>
        <div class="dm-week" id="dmWeek"></div>
      </div>

      <!-- الرصد -->
      <div class="dm-panel" role="tabpanel" id="dmp-listen" aria-labelledby="dmt-listen" hidden>
        <div class="dm-row">
          <div class="dm-chips" id="dmKeys" role="group" aria-label="الكلمات المرصودة"></div>
          <form id="dmKeyForm" class="dm-keyform"><label class="sr-only" for="dmKey">كلمة جديدة</label><input id="dmKey" maxlength="30" placeholder="أضف كلمة أو منافسًا"><button class="btn secondary" type="submit">أضف</button></form>
        </div>
        <div class="dm-two">
          <figure class="dm-card"><figcaption>المشاعر هذا الأسبوع</figcaption><div id="dmSent" class="dm-sent"></div></figure>
          <figure class="dm-card"><figcaption>حصة الحديث مقارنة بالمنافسين</figcaption><div id="dmSov" class="dm-plat"></div></figure>
        </div>
        <div class="dm-row" style="margin-top:14px">
          <h3>آخر الإشارات</h3>
          <div class="seg" role="group" aria-label="تصفية الإشارات" id="dmSentFilter">
            <button type="button" data-s="all" aria-pressed="true">الكل</button>
            <button type="button" data-s="neg" aria-pressed="false">سلبي</button>
            <button type="button" data-s="pos" aria-pressed="false">إيجابي</button>
          </div>
        </div>
        <div class="dm-mentions" id="dmMentions"></div>
      </div>

      <!-- التصميم -->
      <div class="dm-panel" role="tabpanel" id="dmp-design" aria-labelledby="dmt-design" hidden>
        <div class="dm-design">
          <form class="dm-card dm-dform" id="dmDesignForm">
            <label class="dm-upload"><input type="file" accept="image/*" id="dmProduct"><span>ارفع صورة منتجك الأصلية</span><small>تبقى في متصفحك ولا تُرفع لأي خادم</small></label>
            <p class="dm-flabel">المشهد</p>
            <div class="dm-chips" role="group" aria-label="المشهد" id="dmScenes">
              <button type="button" class="dm-pill" aria-pressed="true" data-scene="desk">مكتب</button>
              <button type="button" class="dm-pill" aria-pressed="false" data-scene="kitchen">مطبخ</button>
              <button type="button" class="dm-pill" aria-pressed="false" data-scene="nature">طبيعة</button>
              <button type="button" class="dm-pill" aria-pressed="false" data-scene="studio">استوديو</button>
            </div>
            <label class="dm-flabel" for="dmHead">النص على التصميم</label>
            <input id="dmHead" maxlength="40" value="ترطيب يدوم طوال اليوم">
            <button class="btn primary" type="submit">ولّد التصاميم</button>
          </form>
          <div class="dm-card dm-dout" id="dmDesignOut" aria-live="polite"><p class="muted">اختر المشهد واضغط «ولّد التصاميم».</p></div>
        </div>
      </div>

      <!-- الصوت -->
      <div class="dm-panel" role="tabpanel" id="dmp-voice" aria-labelledby="dmt-voice" hidden>
        <form class="dm-card dm-vform" id="dmVoiceForm">
          <label for="dmScript">نص التعليق الصوتي</label>
          <textarea id="dmScript" rows="3" maxlength="300">صباحك مزدحم؟ روتينك لا يلزم أن يكون كذلك. خطوة واحدة وترطيب يدوم طوال اليوم. اطلبيه الآن.</textarea>
          <div class="dm-compose-bar">
            <label class="dm-when"><span>اللهجة</span><select id="dmDialect"><option>نجدية</option><option>حجازية</option><option>فصحى</option></select></label>
            <label class="dm-when"><span>الصوت</span><select id="dmVoiceName"><option>نورة · هادئ</option><option>فهد · واثق</option></select></label>
            <span class="dm-est" id="dmEst"></span>
            <button class="btn primary" type="submit">ولّد الصوت</button>
          </div>
        </form>
        <div class="dm-card dm-player" id="dmPlayer" hidden>
          <button class="btn primary dm-play" type="button" id="dmPlay" aria-label="تشغيل">▶</button>
          <div class="dm-wave" id="dmWave" aria-hidden="true"></div>
          <span class="dm-time" id="dmTime"></span>
          <a class="btn secondary" id="dmDl" href="#" role="button" aria-disabled="true">تحميل</a>
        </div>
        <p class="dm-note" id="dmVoiceNote"></p>
      </div>

      <!-- المعرفة -->
      <div class="dm-panel" role="tabpanel" id="dmp-knowledge" aria-labelledby="dmt-knowledge" hidden>
        <div class="dm-two">
          <figure class="dm-card"><figcaption>الأهداف</figcaption><div class="dm-goals" id="dmGoals"></div></figure>
          <figure class="dm-card"><figcaption>القواعد التي يلتزم بها الوكلاء</figcaption>
            <ul class="dm-rules" id="dmRules"></ul>
            <form class="dm-keyform" id="dmRuleForm"><label class="sr-only" for="dmRule">قاعدة جديدة</label><input id="dmRule" maxlength="80" placeholder="مثال: لا إعلانات بعد منتصف الليل"><button class="btn secondary" type="submit">أضف</button></form>
          </figure>
          <figure class="dm-card dm-wide"><figcaption>دروس تعلّمها النظام من نتائجك</figcaption><ul class="dm-lessons" id="dmLessons"></ul></figure>
        </div>
      </div>

      <!-- الربط والإعدادات -->
      <div class="dm-panel" role="tabpanel" id="dmp-connect" aria-labelledby="dmt-connect" hidden>
        <div class="dm-two">
          <figure class="dm-card"><figcaption>المنصات</figcaption><div class="dm-conns" id="dmConns"></div></figure>
          <figure class="dm-card"><figcaption>طريقة عمل كل وكيل</figcaption><div class="dm-modes" id="dmModes"></div></figure>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>
