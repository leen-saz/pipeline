---
// Footer for every page: the closing line and action, then a large footer with link columns (src/lib/public-site.ts),
// a bottom row, and the wordmark drawn in outline across the bottom edge.
// The hero video plays again behind the closing line (cinematic-web-builder, phase 7): muted, no overlay, only a fade
// at the top edge into the page colour; it waits off screen (preload="none") until the page reaches it.
import { FOOTER, CONTACT, wa } from '../lib/public-site';
interface Props { line?: string; video?: boolean; cta?: string }  // video={false}: no video, a warm colour field instead (the landing)
const { line, video = true, cta } = Astro.props;
---
<div class={video ? 'st-foot-band' : 'st-foot-band st-foot-field'}>
  {video && <video muted playsinline loop autoplay preload="none" poster="/assets/video/light-poster.jpg" aria-hidden="true" data-foot-video disablepictureinpicture>
    <source media="(max-width: 899px)" src="/assets/video/light-540.mp4" type="video/mp4">
    <source src="/assets/video/light-720.mp4" type="video/mp4">
  </video>}
  {line && <p class="st-foot-line">{line}</p>}
  {cta && <p class="st-foot-cta"><a class="btn primary" href="#request">{cta}</a></p>}
  <footer class="st-foot z-foot">
    <div class="st-wrap">
      <div class="z-foot-brand">
        <span class="mark">Apipeline</span>
        <p>شركة تقنية سعودية تبني لوحة قرارات تسويقية يديرها وكلاء أذكياء.</p>
        {CONTACT.whatsapp && <a class="st-wa" href={wa('السلام عليكم، أبي أعرف أكثر عن Apipeline')} rel="noopener" target="_blank"><span dir="ltr">{CONTACT.phoneLabel}</span> · واتساب</a>}
      </div>
      <div class="z-foot-cols">
        {FOOTER.map(c => (
          <nav aria-label={c.title}>
            <p class="z-foot-h">{c.title}</p>
            <ul>{c.links.map(l => <li>{l.href ? <a href={l.href}>{l.label}</a> : <span>{l.label}</span>}</li>)}</ul>
          </nav>
        ))}
      </div>
      <div class="z-foot-bottom">
        <small><span dir="ltr">© 2026 Apipeline</span></small>
      </div>
    </div>
    <p class="z-foot-word" aria-hidden="true" dir="ltr">Apipeline</p>
  </footer>
</div>
