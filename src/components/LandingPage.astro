---
// Public landing page for the Apipeline board, told as a scroll story.
// Copy: .claude/skills/apipeline-saudi-voice (Saudi white dialect for titles, light MSA for detail; no superlatives,
// no testimonials, demo numbers labelled). Motion: src/lib/scroll-story.ts. Styles: /assets/site.css on app.css tokens.
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import RequestForm from './RequestForm.astro';
import OrbHero from './OrbHero.astro';
import PillCards from './PillCards.astro';
import DemoLab from './DemoLab.astro';

const ar = (n: number) => n.toLocaleString('ar-SA');
const LOGOS = ['meta', 'googleads', 'snapchat', 'tiktok', 'googleanalytics', 'x', 'pinterest', 'reddit', 'googlesearchconsole', 'posthog'];

// Pill cards rows (src/components/PillCards.astro): the agents, the platforms, the loop, the numbers
const PILL_ROWS = [
  ['احلم', 'التحليلات', 'مدير الإعلانات', 'التواصل الاجتماعي', 'الرصد', 'التصميم', 'الصوت'],
  ['Meta', 'Google', 'Snapchat', 'TikTok', 'GA4', 'سلة', 'زد', 'X'],
  ['تحديث كل ساعة', 'يحلل السبب', 'يقترح القرار', 'الاعتماد لك', 'توثيق كل خطوة'],
  ['العائد على الإنفاق', 'تكلفة الطلب', 'نسبة النقر', 'الميزانية اليومية', 'القمع', 'السجل'],
];
const PILL_DRIFT = ['إنفاق بلا طلبات', 'تصميم مستهلك', 'رقم بلا سبب', 'ميزانية في غير مكانها'];
const STEPS = [
  ['يجمع', 'كل منصاتك، كل ساعة', 'يجمع أرقام Meta وGoogle وSnapchat وTikTok وGA4 ومبيعات متجرك في لوحة واحدة، دون ملفات تصدير أو نسخ ولصق.'],
  ['يحلل', 'الرقم ومعه سببه', 'يقارن كل رقم بالفترة السابقة، ويحدد المنصة أو الإعلان الذي غيّره.'],
  ['يقترح', 'قرار جاهز بسببه ومخاطرته', 'إيقاف إعلان بلا نتيجة، أو رفع ميزانية إعلان يتجاوز عائده الهدف، أو تصميم جديد. ومع كل اقتراح طريقة قياس نجاحه.'],
  ['تعتمد', 'أنت صاحب القرار', 'موافقة أو تعديل أو رفض مع ذكر السبب. في وضع الموافقة لا يُنفَّذ شيء دونك.'],
  ['يسجّل', 'كل خطوة موثّقة', 'كل تنفيذ يُوثَّق في السجل، وتُقاس نتيجته بعد ٣ و٧ أيام ليتعلم منها في الاقتراح التالي.'],
];

const AGENTS = [
  ['يبني', 'احلم', 'تكتب فكرة الحملة، فيجهّز الاستراتيجية والجمهور والميزانية والنصوص والتصاميم والرسوم المتحركة والتعليق الصوتي، ثم ينشئها في المنصات موقوفة.'],
  ['يقيس', 'التحليلات', 'رحلة العميل كاملة، ومع كل رقم سبب تغيّره.'],
  ['يقرر', 'مدير الإعلانات', 'توصيات بأسبابها ومخاطرها وطريقة قياسها، ويتعلم من نتيجة كل قرار.'],
  ['ينشر', 'التواصل الاجتماعي', 'منشور واحد لعدة منصات، بجدولة وموافقة.'],
  ['يراقب', 'الرصد', 'ما يُقال عنك وعن منافسيك، وهل هو إيجابي أم سلبي.'],
  ['يصمم', 'التصميم', 'صورة منتجك في مشهد جديد بكل المقاسات، والنص طبقة مستقلة فوقها.'],
  ['يتحدث', 'الصوت', 'تعليق صوتي بلهجة نجدية بطول إعلانك، تستمع إليه وتحمّله.'],
];

const OUTCOMES = [
  ['قبل', 'كل صباح تجمع الأرقام من خمس منصات، ثم تجتهد في القرار.'],
  ['بعد', 'تفتح اللوحة فتجد الأرقام وأسبابها، والقرار جاهز بانتظار موافقتك.'],
  ['قبل', 'الحملة الجديدة تستغرق أسبوعًا بين الموجز والتصاميم والنصوص.'],
  ['بعد', 'تكتب الفكرة في «احلم»، فتصلك مسودة كاملة تعدّلها وتعتمدها.'],
];

const RULES = [
  ['قراءة فقط', 'لا تُعدَّل حسابات الإعلانات إلا ضمن حملات التجربة التي تحددها.', 'M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z'],
  ['عزل تام لكل شركة', 'بياناتك معزولة عن غيرك من أول جدول.', 'M5 11h14v10H5z M8 11V7a4 4 0 0 1 8 0v4'],
  ['تلقائي أو يدوي', 'تختار لكل وكيل: يعمل تلقائيًا، أو ينتظر موافقتك مع تنبيه.', 'M4 6h10 M18 6h2 M4 12h4 M12 12h8 M4 18h12 M20 18h0 M16 4v4 M10 10v4 M18 16v4'],
];

const FAQ = [
  ['هل يُنفَّذ شيء دون موافقتي؟', 'لا. في وضع الموافقة يصلك كل اقتراح بأرقامه وسببه ومخاطره، ولا يُنفَّذ إلا بعد موافقتك. ويمكنك تشغيل وكيل معيّن تلقائيًا ضمن حدود تحددها.'],
  ['هل ينشر «احلم» الحملة مباشرة؟', 'لا. ينشئ الحملة في المنصات موقوفة، ولا تعمل إلا عندما تشغّلها بنفسك. وقبل الإنشاء يعرض عليك كل ما سيُنشأ.'],
  ['ما المنصات التي يقرأ منها؟', 'Meta وGoogle Ads وSnapchat وTikTok وGA4، مع X وPinterest وReddit وSearch Console. كل ربط يتم بتسجيل الدخول في المنصة نفسها.'],
  ['أين تُحفظ بياناتي؟', 'بيانات كل شركة معزولة عن غيرها، ومفاتيح الربط محفوظة في خزنة مشفّرة. ويمكنك إلغاء أي ربط بضغطة واحدة فتُحذف مفاتيحه.'],
  ['هل يغني عن فريق التسويق؟', 'لا. يختصر على فريقك جمع الأرقام والمتابعة اليومية وتجهيز المواد، ليتفرغوا للقرار والإبداع. والقرار الأخير دائمًا بيد شخص.'],
];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="index,follow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#ECEBE8">
<title>Apipeline · نظام وكلاء أذكياء لإعلاناتك</title>
<meta name="description" content="وكلاء أذكياء يديرون إعلاناتك: يحللون ويقترحون ويوضحون السبب، والاعتماد لك. جرّب العرض التجريبي.">
<link rel="preload" href="/assets/fonts/noto-naskh-arabic-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body class="st st-night st-warm">

<SiteHeader current="/" cta={{ href: '#request', label: 'تواصل معنا' }} />

<main>
  <OrbHero>
      <p class="st-eyebrow">وكلاء أذكياء يديرون إعلاناتك</p>
      <h1 class="st-h1">يقترح القرار ويوضّح سببه. <em>والاعتماد لك.</em></h1>
      <p class="st-lead">يجمع أرقام منصاتك ومبيعاتك كل ساعة، ويقترح القرار مع سببه. تعتمده، فيُنفَّذ ويُوثَّق.</p>
      <div class="st-cta">
        <a class="btn primary" href="#demo">جرّب العرض التجريبي</a>
        <a class="btn secondary" href="#request" data-kind="board">اطلب تجربة على أرقامك</a>
      </div>
      <p class="st-note">الأرقام في الأمثلة بيانات تجريبية.</p>
  </OrbHero>

  <PillCards
    label="مراحل العرض"
    rows={PILL_ROWS}
    steps={[
      { kick: 'كل شيء في مكان واحد', title: 'سبعة وكلاء وأكثر على الأرقام نفسها', text: 'منصاتك وأرقامك في لوحة واحدة تتحدّث كل ساعة.' },
      { kick: 'حساب منضبط', title: 'كل إعلان في مكانه', text: 'الإنفاق يذهب لما يحقق نتيجة، وكل رقم معه سببه.' },
      { kick: 'عند أي خلل', title: 'يرصده الوكيل ويصحّحه بموافقتك', text: 'إعلان ينفق دون طلبات، أو تصميم ملّه الجمهور: يصلك الاقتراح مع سببه، وبعد اعتمادك يعود كل شيء لمكانه.', list: PILL_DRIFT },
    ]}
    drift={PILL_DRIFT}
    fixed="صحّحها الوكيل بموافقتك"
  />

  <section class="st-sec st-demo">
    <div class="st-wrap st-demo-in">
      <header class="st-head" data-reveal>
        <span class="kick">مثال من لوحة القرارات</span>
        <h2>القرار يصلك جاهزًا</h2>
        <p>يصلك كل اقتراح بأرقامه بعد مطابقته مع قواعدك. توافق أو تعدّل أو ترفض.</p>
      </header>
    <div class="st-stack" role="img" aria-label="مثال من لوحة القرارات">
      <article class="st-card" style="inset-inline-start:0;top:24px;width:min(100%,430px);z-index:3" data-depth="0.08">
        <span class="k">اقتراح · Meta</span>
        <h3>إيقاف إعلان أنفق ٣ أيام دون أي عميل محتمل</h3>
        <dl class="st-stats">
          <div><dt>الإنفاق</dt><dd>٨٤٠ ر.س</dd></div>
          <div><dt>العملاء المحتملون</dt><dd>٠</dd></div>
          <div><dt>نسبة النقر</dt><dd>٠٫٤٪</dd></div>
        </dl>
        <div class="st-acts"><span class="btn primary">موافقة</span><span class="btn secondary">تعديل</span><span class="btn ghost">رفض</span></div>
      </article>
      <article class="st-card" style="inset-inline-end:0;top:250px;width:min(88%,360px);z-index:2" data-depth="0.22">
        <span class="k">اقتراح · Snapchat</span>
        <h3>رفع ميزانية مجموعة تكلفتها تحت الهدف بـ ٣٢٪</h3>
        <span class="st-chip ok">المراجع: مطابق لقواعدك</span>
      </article>
    </div>
    </div>
  </section>

  <section class="st-logos" aria-label="المنصات">
    <p>يقرأ من منصاتك</p>
    <div class="st-marquee" aria-hidden="true">
      {[...LOGOS, ...LOGOS].map(l => <span style={`--src:url(/assets/logos/${l}.svg)`}></span>)}
    </div>
  </section>

  <section class="st-words-sec">
    <div class="st-wrap">
      <p class="st-words" data-words>الإنفاق في Meta، والعملاء المحتملون في ملف إكسل، والمبيعات في واتساب. كل منصة تروي جزءًا من القصة، ولا أحد يخبرك بخطوتك القادمة. Apipeline يجمعها في لوحة واحدة، ويضع القرار أمامك.</p>
    </div>
  </section>

  <section class="st-sec" id="outcome" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">ما الذي يتغيّر</span>
        <h2>من الرقم إلى القرار، دون متابعة مرهقة</h2>
      </header>
      <div class="st-grid four">
        {OUTCOMES.map(([t, d]) => <article class="st-tile" data-reveal><h3>{t}</h3><p>{d}</p></article>)}
      </div>
    </div>
  </section>

  <DemoLab />

  <section class="st-sec" id="how" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">كيف يشتغل</span>
        <h2>دورة واحدة تتكرر كل ساعة</h2>
        <p>من الرقم إلى القرار ثم الدرس المستفاد، والكلمة لك. كل خطوة موثّقة ويمكن التراجع عنها.</p>
      </header>
      <div class="st-steps" data-steps>
        <div class="st-steps-visual" data-steps-visual aria-hidden="true">
          <div class="st-panel">
            <span class="k st-chip">آخر مزامنة الآن</span>
            <ul>
              <li>Meta Ads<b>١٢:٠٠</b></li><li>Google Ads<b>١٢:٠٠</b></li><li>Snapchat<b>١٢:٠٠</b></li><li>TikTok<b>١٢:٠٠</b></li><li>GA4<b>١٢:٠٠</b></li>
            </ul>
          </div>
          <div class="st-panel">
            <span class="k" style="color:var(--accent);font:500 12px/1 var(--f-ar)">العائد على الإنفاق</span>
            <h3 style="font:700 20px/1.5 var(--f-ar);margin:0">٣٫٤× <small style="font-size:14px;color:var(--muted)">▲ ١٢٪</small></h3>
            <p style="margin:0;color:var(--muted);font:400 15px/1.8 var(--f-text)">أكبر نمو من TikTok: مبيعات أعلى بالإنفاق نفسه.</p>
          </div>
          <div class="st-panel">
            <span class="k" style="color:var(--accent);font:500 12px/1 var(--f-ar)">اقتراح · Meta</span>
            <h3 style="font:700 20px/1.5 var(--f-ar);margin:0">إيقاف إعلان أنفق ٣ أيام دون أي عميل محتمل</h3>
            <dl class="st-stats"><div><dt>الإنفاق</dt><dd>٨٤٠ ر.س</dd></div><div><dt>العملاء المحتملون</dt><dd>٠</dd></div><div><dt>نسبة النقر</dt><dd>٠٫٤٪</dd></div></dl>
          </div>
          <div class="st-panel">
            <span class="st-chip">بانتظار موافقتك</span>
            <h3 style="font:700 20px/1.5 var(--f-ar);margin:0">إيقاف إعلان أنفق ٣ أيام دون أي عميل محتمل</h3>
            <div class="st-acts"><span class="btn primary">موافقة</span><span class="btn secondary">تعديل</span><span class="btn ghost">رفض</span></div>
          </div>
          <div class="st-panel">
            <span class="st-chip ok">تنفّذ · في السجل</span>
            <ul><li>إيقاف إعلان · Meta<b>١٢:٠٤</b></li><li>قياس بعد ٣ أيام<b>⏳</b></li><li>درس محفوظ<b>✓</b></li></ul>
          </div>
        </div>
        <div class="st-steps-list">
          <span class="st-steps-line" data-steps-line aria-hidden="true"></span>
          <ol style="list-style:none;margin:0;padding:0">
            {STEPS.map(([n, h, p], i) => <li class="st-step" data-step><p class="n">{`${ar(0)}${ar(i + 1)} · ${n}`}</p><h3>{h}</h3><p>{p}</p></li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="st-hs" id="agents" data-hscroll>
    <div class="st-hs-in">
      <div class="st-wrap">
        <header class="st-head">
          <span class="kick">الوكلاء</span>
          <h2>سبعة وكلاء وأكثر، لكل وكيل مهمة واضحة</h2>
          <p>جميعهم يعملون على الأرقام نفسها، وينتظرون موافقتك.</p>
        </header>
      </div>
      <div class="st-track" data-track>
        {AGENTS.map(([g, n, d], i) => <article class="st-agent"><span class="g">{g}</span><h3>{n}</h3><p>{d}</p><span class="ix" aria-hidden="true">{`${ar(0)}${ar(i + 1)}`}</span></article>)}
      </div>
    </div>
  </section>

  <section class="st-sec st-dark" id="safety">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">الأمان</span>
        <h2>قواعد ثابتة</h2>
        <p>النظام يقترح وينفّذ ضمن حدود ترسمها أنت.</p>
      </header>
      <div class="st-grid three">
        {RULES.map(([t, d, p]) => <article class="st-tile" data-reveal><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={p}/></svg></span><h3>{t}</h3><p>{d}</p></article>)}
      </div>
    </div>
  </section>

  <section class="st-sec">
    <div class="st-wrap">
      <div class="st-faq-wrap">
      <header class="st-head" data-reveal><span class="kick">أسئلة</span><h2>قبل أن تبدأ</h2><p>لم تجد سؤالك؟ اكتبه في نموذج الطلب، ونرد عليك خلال يوم عمل.</p></header>
      <div class="st-faq">
        {FAQ.map(([q, a], i) => <details data-reveal name="faq" open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
      </div>
      </div>
    </div>
  </section>

  <RequestForm kind="board" title="اربط حساباتك ودع الأرقام تتحدث" lead="أخبرنا بمنصاتك وحجم إنفاقك، ونجهّز لك تجربة على أرقامك. يتم كل ربط بتسجيل الدخول في المنصة نفسها، دون ملفات تصدير أو مفاتيح." />
</main>

<SiteFooter video={false} line="الأرقام تتحدث، والقرار لك." cta="اطلب تجربة على أرقامك" />

<script is:inline type="module" src="/assets/welcome.js"></script>
<script>import '../lib/scroll-story'; import '../lib/orb'; import '../lib/pill-cards'; import '../lib/request-form'; import '../lib/demo';</script>
</body>
</html>
