---
export const prerender = true;
// Apipeline company profile: one page that reads as a scroll story on screen and prints as an A4 PDF
// (site.css @media print, the "حمّل PDF" button calls window.print). Static page.
// Only facts the product shows: counts of agents, platforms and steps come from the home page's lists.
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RequestForm from '../../components/RequestForm.astro';
import OrbHero from '../../components/OrbHero.astro';


const VALUES = [
  ['الوضوح', 'رقم واحد يفهمه الجميع أفضل من عشرين رقمًا لا يقرؤها أحد.'],
  ['القرار للإنسان', 'الأنظمة تقترح وتجهّز، والشخص المسؤول هو من يعتمد.'],
  ['الأمان أولًا', 'أقل الصلاحيات الممكنة، وسجل موثّق لكل خطوة.'],
  ['الصدق في الأرقام', 'لا نعرض رقمًا لا نستطيع إثباته، ولا نعد بنتيجة خارج سيطرتنا.'],
];

const LINES = [
  ['لوحة Apipeline', 'منصة', 'أرقام منصات الإعلان كلها في لوحة واحدة تتحدّث كل ساعة، وسبعة وكلاء وأكثر يقترحون القرار وينفّذونه بعد موافقتك.', ['مزامنة Meta وGoogle وSnapchat وTikTok وGA4', 'لوحة قرارات بموافقة وتعديل ورفض', 'مراجع يفحص كل اقتراح على قواعدك', 'سجل كامل لكل قرار'], '/'],
  ['خريطة التسرب', 'خدمة نمو', 'قبل زيادة الميزانية، نحدد أين يضيع العميل بين الإعلان والمبيعات، ونرتب الإصلاحات حسب أثرها.', ['مراجعة الإنفاق وجودة العملاء المحتملين', 'تحديد نقطة التسرب: إعلان، عرض، صفحة، أو متابعة', 'خطة ٩٠ يومًا بقرارات واضحة', 'ربط الحملات بالمبيعات'], ''],
];

const HOW = [
  ['نقرأ', 'نفهم نشاطك وأرقامك وأنظمتك كما هي، قبل أي اقتراح.'],
  ['نحدد', 'نرتب المشكلات حسب أثرها الفعلي، لا حسب سهولتها.'],
  ['ننفّذ', 'نصلح ونقيس، وكل تغيير موثّق ويمكن التراجع عنه.'],
  ['نتعلّم', 'كل نتيجة تُبنى عليها القرارات التالية.'],
];

const FIT = [
  'لديك إنفاق إعلاني قائم أو نية جادة للاستثمار فيه',
  'مستعد لمشاركة البيانات والتعامل مع الأرقام بوضوح',
  'تبحث عن تحسين فعلي، لا تقرير نهاية الشهر',
];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="index,follow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#ECEBE8">
<title>Apipeline · بروفايل الشركة</title>
<meta name="description" content="بروفايل Apipeline: من نحن، وما نقدّمه، وكيف نعمل.">
<link rel="preload" href="/assets/fonts/MilanDisplay-Black.otf" as="font" type="font/otf" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<link rel="stylesheet" href="/assets/site.css">
<link rel="stylesheet" href="/assets/system.css">
<style is:global>
.pf-cover{display:flex;flex-direction:column;align-items:center;text-align:center}
.pf-cover .mark{font-size:clamp(64px,13vw,168px);line-height:1;display:block;margin:0 0 28px}
.pf-cover .yr{font:500 15px/1 var(--f-ar);color:var(--muted);letter-spacing:.02em;margin:0 0 18px}
.pf-cover h1{font:700 clamp(24px,3.2vw,40px)/1.4 var(--f-display);max-width:22em;margin:0 0 32px;text-wrap:balance}
.pf-cover .st-cta{justify-content:center}
.pf-line{display:grid;grid-template-columns:.9fr 1.1fr;gap:40px;align-items:start;padding:44px 0;border-top:1px solid var(--line)}
.pf-line h3{font:900 clamp(30px,3.6vw,46px)/1.15 var(--f-display);margin:10px 0 14px}
.pf-line p{font:400 17px/1.85 var(--f-text);color:var(--muted);margin:0 0 18px}
.pf-line ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.pf-line li{display:flex;gap:12px;align-items:baseline;padding:14px 18px;background:var(--surface);border-radius:var(--r-sm);box-shadow:var(--shadow);font:400 15px/1.6 var(--f-ar)}
.pf-line li::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none;transform:translateY(-2px)}
.pf-how{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;counter-reset:h}
.pf-how div{counter-increment:h}
.pf-how div::before{content:counter(h,arabic-indic);display:block;font:900 56px/1 var(--f-display);color:var(--soft);margin:0 0 12px}
[dir="ltr"] .pf-how div::before{content:counter(h)}
.pf-how h3{font:700 22px/1.3 var(--f-display);margin:0 0 8px}
.pf-how p{font:400 15px/1.8 var(--f-text);color:var(--muted);margin:0}
.pf-fit{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pf-fit li{padding:18px 20px;border-radius:var(--r-sm);border:1px solid var(--line);font:400 16px/1.7 var(--f-ar)}
@media (max-width:960px){@media (max-width:640px){.pf-how{grid-template-columns:1fr}}
@media print{.pf-cover{min-height:auto;padding:40mm 0 0}.pf-line li{box-shadow:none;border:1px solid #DDD6F6}}
</style>
<!-- Cloudflare Web Analytics: page views and referrers, no cookies, no personal data -->
<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "4e1d3c4c790b4256b0442c79d2a9c6f8"}'></script>
</head>
<body class="st st-night st-warm st-z">

<SiteHeader current="/profile/" cta={{ href: '#request', label: 'تواصل معنا' }} />

<main>
  <OrbHero>
      <p class="st-eyebrow">بروفايل الشركة · ٢٠٢٦</p>
      <h1 class="st-h1" id="orbH">نحوّل أرقام التسويق <em>إلى قرارات واضحة.</em></h1>
      <p class="st-lead">شركة تقنية سعودية تبني لوحة قرارات تسويقية يديرها وكلاء أذكياء، والاعتماد دائمًا لك.</p>
      <div class="st-cta">
        <button class="btn primary" type="button" data-print>حمّل البروفايل PDF</button>
        <a class="btn secondary" href="#lines">ما نقدّمه</a>
      </div>
  </OrbHero>

  <section class="st-sec">
    <div class="st-wrap">
      <div class="st-grid two">
        <article class="st-tile" data-reveal><span class="st-chip">رؤيتنا</span><h3>أن يُبنى كل قرار تسويقي في المنطقة على رقم واضح.</h3></article>
        <article class="st-tile" data-reveal><span class="st-chip">رسالتنا</span><h3>نجمع الأرقام، ونقترح القرار، ونترك الاعتماد لصاحبه.</h3></article>
      </div>
    </div>
  </section>

  <section class="st-words-sec">
    <div class="st-wrap">
      <p class="st-words" data-words>Apipeline شركة تقنية سعودية. بدأنا من سؤال يتكرر في كل شركة: أين ذهبت الميزانية، وما خطوتنا القادمة؟ واليوم نبني الأدوات التي تجيب عنه.</p>
    </div>
  </section>

  <section class="st-sec st-page" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">قيمنا</span>
        <h2>أربع قواعد نعمل بها</h2>
      </header>
      <div class="st-grid four">
        {VALUES.map(([t, d]) => <article class="st-tile" data-reveal><h3>{t}</h3><p>{d}</p></article>)}
      </div>
    </div>
  </section>

  <section class="st-sec st-dark">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">بالأرقام</span>
        <h2>ما يقدّمه المنتج اليوم</h2>
      </header>
      <div class="st-nums">
        <div data-reveal><b data-count="7">٧</b><span>وكلاء وأكثر، لكل وكيل مهمة واضحة</span></div>
        <div data-reveal><b data-count="10">١٠</b><span>منصات يقرأ منها</span></div>
        <div data-reveal><b data-count="24">٢٤</b><span>مزامنة في اليوم، كل ساعة</span></div>
        <div data-reveal><b data-count="5">٥</b><span>خطوات في كل قرار، من الرقم إلى الدرس</span></div>
      </div>
    </div>
  </section>

  <section class="st-sec st-page" id="lines">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">ما نقدّمه</span>
        <h2>مساران، ومنهجية واحدة</h2>
      </header>
      {LINES.map(([t, tag, d, list, href]) => (
        <article class="pf-line" data-reveal>
          <div>
            <span class="st-chip">{tag}</span>
            <h3>{t}</h3>
            <p>{d}</p>
            {href && <a class="btn secondary sm st-noprint" href={href as string}>اعرف أكثر</a>}
          </div>
          <ul>{(list as string[]).map(x => <li>{x}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section class="st-sec" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">كيف نعمل</span>
        <h2>لا نغيّر شيئًا قبل أن نحدد موضع الخلل</h2>
      </header>
      <div class="pf-how">
        {HOW.map(([t, d]) => <div data-reveal><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="st-sec st-page" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">لمن</span>
        <h2>نناسبك إن كنت تريد الحقيقة قبل القرار</h2>
      </header>
      <ul class="pf-fit">
        {FIT.map(x => <li data-reveal>{x}</li>)}
      </ul>
    </div>
  </section>

  <div class="st-noprint"><RequestForm kind="board" title="لنبدأ من أرقامك" lead="اختر ما تحتاجه: تجربة اللوحة أو خريطة التسرب لإعلاناتك، ونرد عليك خلال يوم عمل." /></div>
</main>

<SiteFooter video={false} line="نحوّل الأرقام إلى قرارات واضحة." cta="اطلب تجربة على أرقامك" />

<script is:inline type="module" src="/assets/welcome.js"></script>
<script>
  import '../../lib/scroll-story';
  import '../../lib/orb';
  import '../../lib/request-form';
  // Print the profile: everything shown first (the reveals may not have run yet below the fold)
  document.querySelector('[data-print]')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(el => { el.style.opacity = '1'; el.style.visibility = 'visible'; el.style.transform = 'none'; });
    window.print();
  });
</script>
</body>
</html>
