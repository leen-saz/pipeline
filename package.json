    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261103.1": true,
    "workerd@1.20261104.1": true
